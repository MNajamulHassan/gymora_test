@model MemberEditViewModel
@{
    ViewData["Title"] = "Edit Member Profile";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0"><i class="bi bi-pencil-square"></i> Edit Member Profile</h3>
    <a asp-controller="Member" asp-action="Detail" asp-route-id="@Model.Id" class="gymora-btn-ghost">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="gymora-card">
    <div class="p-4">
        <form asp-controller="Member" asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <!-- Email (read-only) -->
            <div class="mb-4">
                <label class="gymora-form-label">Email</label>
                <input type="text" value="@Model.Email" class="form-control" disabled />
                <div class="form-text text-muted">Email cannot be changed here.</div>
            </div>

            <div class="row g-4">
                <!-- Left Column -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="FullName" class="gymora-form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="gymora-form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" type="tel" placeholder="+92XXXXXXXXXX" pattern="^\+92[0-9]{10}$" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Gender" class="gymora-form-label">Gender</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DateOfBirth" class="gymora-form-label"></label>
                        <input asp-for="DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CNIC" class="gymora-form-label"></label>
                        <input asp-for="CNIC" class="form-control" />
                        <span asp-validation-for="CNIC" class="text-danger small"></span>
                        <div class="form-text" style="color: var(--gymora-muted); font-size: 12px;">Format: XXXXX-XXXXXXX-X (e.g. 35202-1234567-8)</div>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Address" class="gymora-form-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmergencyContact" class="gymora-form-label"></label>
                        <input asp-for="EmergencyContact" class="form-control" />
                        <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                        <div class="form-text" style="color: var(--gymora-muted); font-size: 12px;">Include both name and phone number (e.g. Ahmed Ali — 0300-1234567)</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="HealthConditions" class="gymora-form-label"></label>
                        <textarea asp-for="HealthConditions" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="HealthConditions" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FitnessGoals" class="gymora-form-label"></label>
                        <textarea asp-for="FitnessGoals" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="FitnessGoals" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CurrentPlanId" class="gymora-form-label"></label>
                        <select asp-for="CurrentPlanId" asp-items="Model.PlanOptions" class="form-select"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PlanStartDate" class="gymora-form-label"></label>
                        <input asp-for="PlanStartDate" class="form-control" type="date" />
                        <span asp-validation-for="PlanStartDate" class="text-danger small"></span>
                        <div class="form-text">Expiry auto-calculates from selected plan duration.</div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Active Member</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="gymora-btn-primary" id="mainSubmitBtn" onclick="gymoraSubmitting(this)">
                    <i class="bi bi-check-circle"></i> Save Changes
                </button>
                <a asp-controller="Member" asp-action="Detail" asp-route-id="@Model.Id"
                   class="gymora-btn-ghost">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
