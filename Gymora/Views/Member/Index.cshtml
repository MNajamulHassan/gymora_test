@model MemberListViewModel
@{
    ViewData["Title"] = "Members";
    var memberNextDir = Model.SortBy == "name" && (Model.SortDir ?? "asc") == "asc" ? "desc" : "asc";
    var memberIcon = Model.SortBy == "name"
        ? ((Model.SortDir ?? "asc") == "asc" ? "bi-chevron-up" : "bi-chevron-down")
        : "bi-arrow-down-up";
    var joinedNextDir = Model.SortBy == "joined" && (Model.SortDir ?? "asc") == "asc" ? "desc" : "asc";
    var joinedIcon = Model.SortBy == "joined"
        ? ((Model.SortDir ?? "asc") == "asc" ? "bi-chevron-up" : "bi-chevron-down")
        : "bi-arrow-down-up";
    var statusNextDir = Model.SortBy == "status" && (Model.SortDir ?? "asc") == "asc" ? "desc" : "asc";
    var statusIcon = Model.SortBy == "status"
        ? ((Model.SortDir ?? "asc") == "asc" ? "bi-chevron-up" : "bi-chevron-down")
        : "bi-arrow-down-up";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="gymora-card-title mb-0">
        Members <span style="color:#9A9A9A;font-weight:500;">(@Model.TotalCount)</span>
    </div>
    <a asp-controller="Member" asp-action="Create"
       class="gymora-btn-primary text-decoration-none d-inline-flex align-items-center gap-2 flex-shrink-0">
        <i class="bi bi-person-plus"></i> Add Member
    </a>
</div>

<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
    <span style="color:var(--gymora-muted);font-size:13px;">Filter:</span>
    <a asp-controller="Member" asp-action="Index"
       asp-route-search="@Model.SearchQuery" asp-route-page="1" asp-route-sortBy="@Model.SortBy" asp-route-sortDir="@Model.SortDir"
       asp-route-statusFilter=""
       class="gymora-btn-ghost text-decoration-none d-inline-flex align-items-center gap-1"
       style="padding:6px 14px;font-size:12px;@(string.IsNullOrEmpty(Model.StatusFilter) ? "background:var(--gymora-primary-dim);color:var(--gymora-primary);border-color:var(--gymora-primary);" : "")">
        All
    </a>
    <a asp-controller="Member" asp-action="Index"
       asp-route-search="@Model.SearchQuery" asp-route-page="1" asp-route-sortBy="@Model.SortBy" asp-route-sortDir="@Model.SortDir"
       asp-route-statusFilter="active"
       class="gymora-btn-ghost text-decoration-none d-inline-flex align-items-center gap-1"
       style="padding:6px 14px;font-size:12px;@(Model.StatusFilter == "active" ? "background:rgba(183,240,114,0.12);color:var(--gymora-secondary);border-color:rgba(183,240,114,0.3);" : "")">
        <i class="bi bi-circle-fill" style="font-size:7px;color:var(--gymora-secondary);"></i> Active
    </a>
    <a asp-controller="Member" asp-action="Index"
       asp-route-search="@Model.SearchQuery" asp-route-page="1" asp-route-sortBy="@Model.SortBy" asp-route-sortDir="@Model.SortDir"
       asp-route-statusFilter="inactive"
       class="gymora-btn-ghost text-decoration-none d-inline-flex align-items-center gap-1"
       style="padding:6px 14px;font-size:12px;@(Model.StatusFilter == "inactive" ? "background:rgba(224,82,82,0.12);color:var(--gymora-danger);border-color:rgba(224,82,82,0.3);" : "")">
        <i class="bi bi-circle-fill" style="font-size:7px;color:var(--gymora-danger);"></i> Inactive
    </a>
</div>

<form asp-controller="Member" asp-action="Index" method="get" class="d-flex align-items-stretch gap-2 mb-4">
    <input type="hidden" name="sortBy" value="@Model.SortBy" />
    <input type="hidden" name="sortDir" value="@Model.SortDir" />
    <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
    <div class="flex-grow-1">
        <input asp-for="SearchQuery" name="search" class="gymora-input w-100"
               placeholder="Search by name, email or phone..." />
    </div>
    <button type="submit"
            class="gymora-btn-primary d-inline-flex align-items-center justify-content-center flex-shrink-0"
            style="padding:10px 16px;" aria-label="Search">
        <i class="bi bi-search"></i>
    </button>
    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
    {
        <a asp-controller="Member" asp-action="Index"
           asp-route-sortBy="@Model.SortBy" asp-route-sortDir="@Model.SortDir" asp-route-statusFilter="@Model.StatusFilter"
           class="gymora-btn-ghost d-inline-flex align-items-center justify-content-center flex-shrink-0 text-decoration-none">
            Clear
        </a>
    }
</form>

@if (Model.Members.Count == 0)
{
    <div class="gymora-card">
        <div class="text-center py-5 px-3">
            <i class="bi bi-people d-block mb-3" style="font-size:3rem;color:#9A9A9A;"></i>
            <div class="gymora-card-title mb-2">No members found</div>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <div style="color:#9A9A9A;font-size:14px;">Try a different search term</div>
            }
            else
            {
                <a asp-controller="Member" asp-action="Create"
                   class="gymora-btn-primary mt-2 text-decoration-none d-inline-flex align-items-center gap-2">
                    <i class="bi bi-person-plus"></i> Add your first member
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="gymora-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="gymora-table mb-0" style="table-layout:auto;">
                <thead>
                    <tr>
                        <th style="width:40px;">#</th>
                        <th>
                            <a asp-controller="Member" asp-action="Index"
                               asp-route-search="@Model.SearchQuery"
                               asp-route-page="1"
                               asp-route-sortBy="name"
                               asp-route-sortDir="@memberNextDir"
                               asp-route-statusFilter="@Model.StatusFilter"
                               style="color:var(--gymora-text);text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
                                Member <i class="bi @memberIcon" style="color:var(--gymora-muted);font-size:11px;"></i>
                            </a>
                        </th>
                        <th class="col-phone">Phone</th>
                        <th class="col-gender">Gender</th>
                        <th class="col-joined">
                            <a asp-controller="Member" asp-action="Index"
                               asp-route-search="@Model.SearchQuery"
                               asp-route-page="1"
                               asp-route-sortBy="joined"
                               asp-route-sortDir="@joinedNextDir"
                               asp-route-statusFilter="@Model.StatusFilter"
                               style="color:var(--gymora-text);text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
                                Joined <i class="bi @joinedIcon" style="color:var(--gymora-muted);font-size:11px;"></i>
                            </a>
                        </th>
                        <th style="width:90px;">
                            <a asp-controller="Member" asp-action="Index"
                               asp-route-search="@Model.SearchQuery"
                               asp-route-page="1"
                               asp-route-sortBy="status"
                               asp-route-sortDir="@statusNextDir"
                               asp-route-statusFilter="@Model.StatusFilter"
                               style="color:var(--gymora-text);text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
                                Status <i class="bi @statusIcon" style="color:var(--gymora-muted);font-size:11px;"></i>
                            </a>
                        </th>
                        <th style="width:180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var rowNum = (Model.PageNumber - 1) * Model.PageSize + 1;
                    }
                    @foreach (var member in Model.Members)
                    {
                        var fn = member.FullName?.Trim() ?? "";
                        var avatarLetter = string.IsNullOrEmpty(fn) ? "?" : char.ToUpperInvariant(fn[0]).ToString();
                        var displayRow = rowNum;
                        var detailUrl = Url.Action("Detail", "Member", new { id = member.Id });
                        rowNum++;

                        <tr style="cursor:pointer;" onclick="window.location='@detailUrl'" title="View @member.FullName">
                            <td>@displayRow</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:34px;height:34px;background:#E16349;color:#FFFFFF;font-weight:700;font-size:13px;">
                                        @avatarLetter
                                    </div>
                                    <div style="min-width:0;">
                                        <div style="font-weight:600;color:var(--gymora-text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                            @member.FullName
                                        </div>
                                        <div style="font-size:11px;color:#9A9A9A;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:160px;">
                                            @member.Email
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="col-phone">@(member.PhoneNumber ?? "—")</td>
                            <td class="col-gender">@(member.Gender ?? "—")</td>
                            <td class="col-joined">@(member.JoinDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                            <td>
                                <span class="gymora-badge @(member.IsActive ? "success" : "danger")">
                                    @member.StatusBadge
                                </span>
                            </td>
                            <td onclick="event.stopPropagation()">
                                <div class="d-flex align-items-center gap-1" style="flex-wrap:nowrap;">
                                    <!-- Edit -->
                                    <a asp-controller="Member" asp-action="Edit" asp-route-id="@member.Id"
                                       class="gymora-btn-ghost d-inline-flex align-items-center gap-1 text-decoration-none"
                                       style="padding:6px 12px;font-size:12px;white-space:nowrap;" title="Edit member">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>

                                    @if (User.IsInRole("GymOwner"))
                                    {
                                        @if (member.IsActive)
                                        {
                                            <form asp-controller="Member" asp-action="Deactivate"
                                                  asp-route-id="@member.Id" method="post" class="m-0" id="deactivateForm-@member.Id">
                                                @Html.AntiForgeryToken()
                                                <button type="button"
                                                        class="gymora-btn-danger d-inline-flex align-items-center gap-1"
                                                        style="padding:6px 12px;font-size:12px;white-space:nowrap;"
                                                        title="Deactivate member"
                                                        onclick="event.stopPropagation(); gymoraConfirm({ title:'Deactivate Member', message:'This member will lose access but their data is kept safely.', btnLabel:'Deactivate', iconClass:'bi-person-dash-fill', onConfirm: function(){ document.getElementById('deactivateForm-@(member.Id)').submit(); } });">
                                                    <i class="bi bi-person-dash-fill"></i>
                                                    <span>Deactivate</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Member" asp-action="Reactivate"
                                                  asp-route-id="@member.Id" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="d-inline-flex align-items-center gap-1"
                                                        style="padding:6px 12px;font-size:12px;white-space:nowrap;background:rgba(183,240,114,0.12);color:#B7F072;border:1px solid rgba(183,240,114,0.3);border-radius:8px;cursor:pointer;font-family:'Inter',sans-serif;"
                                                        title="Reactivate member"
                                                        onclick="event.stopPropagation(); return confirm('Reactivate @Html.Raw((member.FullName ?? "").Replace("'","\\'")), they will regain access.');">
                                                    <i class="bi bi-person-check-fill"></i>
                                                    <span>Reactivate</span>
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex flex-wrap justify-content-center align-items-center gap-2 mt-4" aria-label="Pagination">
            @if (Model.PageNumber > 1)
            {
                <a asp-controller="Member" asp-action="Index"
                   asp-route-search="@Model.SearchQuery"
                   asp-route-page="@(Model.PageNumber - 1)"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-sortDir="@Model.SortDir"
                   asp-route-statusFilter="@Model.StatusFilter"
                   class="gymora-btn-ghost text-decoration-none d-inline-flex align-items-center gap-1">
                    <i class="bi bi-chevron-left"></i> Prev
                </a>
            }
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                if (p == Model.PageNumber)
                {
                    <span class="d-inline-flex align-items-center justify-content-center fw-semibold"
                          style="background:#E16349;color:#fff;min-width:40px;padding:8px 12px;font-size:14px;border-radius:8px;">@p</span>
                }
                else
                {
                    <a asp-controller="Member" asp-action="Index"
                       asp-route-search="@Model.SearchQuery"
                       asp-route-page="@p"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-sortDir="@Model.SortDir"
                       asp-route-statusFilter="@Model.StatusFilter"
                       class="gymora-btn-ghost text-decoration-none d-inline-flex align-items-center justify-content-center"
                       style="min-width:40px;padding:8px 12px;">
                        @p
                    </a>
                }
            }
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a asp-controller="Member" asp-action="Index"
                   asp-route-search="@Model.SearchQuery"
                   asp-route-page="@(Model.PageNumber + 1)"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-sortDir="@Model.SortDir"
                   asp-route-statusFilter="@Model.StatusFilter"
                   class="gymora-btn-ghost text-decoration-none d-inline-flex align-items-center gap-1">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            }
        </nav>
    }
}
