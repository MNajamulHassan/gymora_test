@model MemberCreateViewModel
@{
    ViewData["Title"] = "Add New Member";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0"><i class="bi bi-person-plus"></i> Add New Member</h3>
    <a asp-controller="Member" asp-action="Index" class="gymora-btn-ghost">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="gymora-card">
    <form asp-controller="Member" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-4">
            <!-- Left Column -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="FullName" class="gymora-form-label"></label>
                    <input asp-for="FullName" class="form-control" placeholder="Full name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="gymora-form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="Email address" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="gymora-form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" type="tel" placeholder="+92XXXXXXXXXX" pattern="^\+92[0-9]{10}$" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="gymora-form-label"></label>
                    <div class="input-group">
                        <input asp-for="Password" class="form-control" id="memberPasswordInput" placeholder="Minimum 6 characters" autocomplete="new-password" />
                        <button type="button" class="input-group-text" onclick="gymoraTogglePassword('memberPasswordInput', 'memberPasswordIcon')" style="cursor:pointer;border-left:none;">
                            <i class="bi bi-eye" id="memberPasswordIcon"></i>
                        </button>
                    </div>
                    <div class="form-text text-muted">Member should change this on first login.</div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Gender" class="gymora-form-label">Gender</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">-- Select Gender --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="DateOfBirth" class="gymora-form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="CNIC" class="gymora-form-label"></label>
                    <input asp-for="CNIC" class="form-control" placeholder="XXXXX-XXXXXXX-X" />
                    <span asp-validation-for="CNIC" class="text-danger small"></span>
                    <div class="form-text" style="color: var(--gymora-muted); font-size: 12px;">Format: XXXXX-XXXXXXX-X (e.g. 35202-1234567-8)</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Address" class="gymora-form-label"></label>
                    <input asp-for="Address" class="form-control" placeholder="Full address" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="EmergencyContact" class="gymora-form-label"></label>
                    <input asp-for="EmergencyContact" class="form-control" placeholder="Name - Phone number" />
                    <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                    <div class="form-text" style="color: var(--gymora-muted); font-size: 12px;">Include both name and phone number (e.g. Ahmed Ali — 0300-1234567)</div>
                </div>
                <div class="mb-3">
                    <label asp-for="HealthConditions" class="gymora-form-label"></label>
                    <textarea asp-for="HealthConditions" class="form-control" rows="3"
                              placeholder="Any medical conditions..."></textarea>
                    <span asp-validation-for="HealthConditions" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="FitnessGoals" class="gymora-form-label"></label>
                    <textarea asp-for="FitnessGoals" class="form-control" rows="3"
                              placeholder="e.g. Lose weight, gain muscle..."></textarea>
                    <span asp-validation-for="FitnessGoals" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="gymora-btn-primary" id="mainSubmitBtn" onclick="gymoraSubmitting(this)">
                <i class="bi bi-check-circle"></i> Save Member
            </button>
            <a asp-controller="Member" asp-action="Index" class="gymora-btn-ghost">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function gymoraTogglePassword(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
}
