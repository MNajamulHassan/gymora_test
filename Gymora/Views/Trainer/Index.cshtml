@model List<Gymora.Data.Entities.Trainer>
@{
    ViewData["Title"] = "Trainers";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3" role="alert">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3" role="alert">@TempData["Error"]</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div class="gymora-card-title mb-0" style="font-size:18px;">Trainers</div>
    <a asp-controller="Trainer" asp-action="Create" class="gymora-btn-primary text-decoration-none d-inline-flex align-items-center gap-2 flex-shrink-0">
        <i class="bi bi-plus-lg"></i> Add Trainer
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="gymora-card">
        <div class="text-center py-5 px-3">
            <i class="bi bi-person-workspace d-block mb-3" style="font-size:3rem;color:#9A9A9A;"></i>
            <div class="gymora-card-title mb-2">No trainers yet</div>
            <div style="color:#9A9A9A;font-size:14px;">Add your first trainer to assign plans.</div>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var trainer in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="gymora-card h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <div style="font-size:16px;font-weight:600;color:var(--gymora-text);">@trainer.FullName</div>
                        <span class="gymora-badge @(trainer.IsActive ? "success" : "muted")">
                            @(trainer.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                    <div style="color:#9A9A9A;font-size:13px;" class="mb-1">
                        <strong>Specialization:</strong> @(string.IsNullOrWhiteSpace(trainer.Specialization) ? "—" : trainer.Specialization)
                    </div>
                    <div style="color:#9A9A9A;font-size:13px;" class="mb-3">
                        <strong>Phone:</strong> @(string.IsNullOrWhiteSpace(trainer.PhoneNumber) ? "—" : trainer.PhoneNumber)
                    </div>

                    <hr class="mt-auto mb-3" style="border-color:var(--gymora-border);opacity:1;" />

                    <div class="d-flex gap-2">
                        <a asp-controller="Trainer" asp-action="Edit" asp-route-id="@trainer.TrainerId"
                           class="gymora-btn-ghost text-decoration-none d-inline-flex align-items-center justify-content-center gap-1 flex-grow-1">
                            <i class="bi bi-pencil"></i> Edit
                        </a>

                        <form asp-controller="Trainer" asp-action="ToggleActive" asp-route-id="@trainer.TrainerId" method="post" class="flex-grow-1 d-flex">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="gymora-btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-@(trainer.IsActive ? "pause-circle" : "play-circle")"></i>
                                @(trainer.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
