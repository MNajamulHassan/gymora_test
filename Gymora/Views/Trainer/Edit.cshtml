@model Gymora.Models.ViewModels.Trainer.TrainerFormViewModel
@{
    ViewData["Title"] = "Edit Trainer";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0"><i class="bi bi-pencil-square"></i> Edit Trainer</h3>
    <a asp-controller="Trainer" asp-action="Index" class="gymora-btn-ghost">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="gymora-card">
    <div class="p-4">
        <form asp-controller="Trainer" asp-action="Edit" asp-route-id="@Model.TrainerId" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="TrainerId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="gymora-form-label"></label>
                <input asp-for="FullName" class="form-control gymora-input" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Specialization" class="gymora-form-label"></label>
                <input asp-for="Specialization" class="form-control gymora-input" />
                <span asp-validation-for="Specialization" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="gymora-form-label"></label>
                <input asp-for="PhoneNumber" class="form-control gymora-input" type="tel" placeholder="+92XXXXXXXXXX" pattern="^\+92[0-9]{10}$" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="gymora-btn-primary" id="mainSubmitBtn" onclick="gymoraSubmitting(this)">
                    <i class="bi bi-check-circle"></i> Save Changes
                </button>
                <a asp-controller="Trainer" asp-action="Index" class="gymora-btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
