@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="d-flex flex-column align-items-center justify-content-center py-5 px-3 mx-auto w-100" style="max-width:440px;">
    <div class="text-center mb-4">
        <div class="mb-2" style="font-size:22px;font-weight:700;color:var(--gymora-text);">
            ⚡ Gym<span style="color:#E16349;">ora</span>
        </div>
        <div style="color:var(--gymora-muted);font-size:14px;">Sign in to continue</div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger w-100 mb-3" role="alert">@TempData["Error"]</div>
    }

    <div class="gymora-card w-100" style="max-width:400px;">
        <form asp-controller="Auth" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
            }

            <div class="mb-3">
                <label asp-for="Email" class="gymora-form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-envelope"></i>
                    </span>
                    <input asp-for="Email" class="form-control" placeholder="Enter your email" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="gymora-form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-lock"></i>
                    </span>
                    <input asp-for="Password" class="form-control" id="passwordInput" placeholder="Enter your password" autocomplete="current-password" />
                    <button type="button" class="input-group-text" id="togglePassword" style="cursor:pointer;border-left:none;">
                         <i class="bi bi-eye" id="toggleIcon"></i>
                     </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 d-flex align-items-center gap-2">
                <input asp-for="RememberMe" class="form-check-input m-0" style="width:18px;height:18px;flex-shrink:0;" />
                <label asp-for="RememberMe" class="form-check-label" style="color:var(--gymora-muted);font-size:14px;cursor:pointer;">
                    Remember me
                </label>
            </div>

            <button type="submit" class="gymora-btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-box-arrow-in-right"></i> Login
            </button>
        </form>
    </div>

    <div class="text-center mt-4" style="color:var(--gymora-muted);font-size:14px;">
        New member?
        <a asp-controller="Auth" asp-action="Register" class="text-decoration-none fw-semibold" style="color:#E16349;">Register</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            var input = document.getElementById('passwordInput');
            var icon = document.getElementById('toggleIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        });
    </script>
}