@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="gymora-card">
            <div class="gymora-card-title mb-3">
                <i class="bi bi-person-plus"></i> New Member Registration
            </div>
            <div class="p-4">
                <form asp-controller="Auth" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger d-none" id="validation-summary"></div>

                    <div class="row g-4">
                        <!-- Left Column -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="FullName" class="gymora-form-label"></label>
                                <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Email" class="gymora-form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="PhoneNumber" class="gymora-form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="+92 300 0000000" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Gender" class="gymora-form-label">Gender</label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="DateOfBirth" class="gymora-form-label"></label>
                                <input asp-for="DateOfBirth" class="form-control" type="date" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Password" class="gymora-form-label"></label>
                                <input asp-for="Password" class="form-control" placeholder="Minimum 6 characters" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="gymora-form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat your password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="FitnessGoals" class="gymora-form-label"></label>
                                <textarea asp-for="FitnessGoals" class="form-control" rows="3"
                                          placeholder="e.g. Lose weight, build muscle..."></textarea>
                                <span asp-validation-for="FitnessGoals" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="HealthConditions" class="gymora-form-label"></label>
                                <textarea asp-for="HealthConditions" class="form-control" rows="3"
                                          placeholder="Any medical conditions we should know about..."></textarea>
                                <span asp-validation-for="HealthConditions" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="gymora-btn-primary">
                            <i class="bi bi-check-circle"></i> Register as Member
                        </button>
                        <a asp-controller="Auth" asp-action="Login" class="gymora-btn-ghost">
                            Already have an account? Login
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show validation summary if it has errors
        var vs = document.querySelector('[data-valmsg-summary]');
        if (vs && vs.querySelector('li')) {
            vs.classList.remove('d-none');
        }
    </script>
}
