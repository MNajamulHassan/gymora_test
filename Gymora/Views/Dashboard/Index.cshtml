@model Gymora.Models.ViewModels.Dashboard.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    // Serialize chart data server-side so JS can consume it safely
    var chartLabels = System.Text.Json.JsonSerializer.Serialize(
        Model.MonthlyJoins.Select(m => m.Label).ToList());
    var chartData = System.Text.Json.JsonSerializer.Serialize(
        Model.MonthlyJoins.Select(m => m.Count).ToList());
    var maxVal = Model.MonthlyJoins.Any() ? Model.MonthlyJoins.Max(m => m.Count) : 0;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-0">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-0">@TempData["Error"]</div>
}

@if (Model.TotalMembers == 0)
{
    <div class="gymora-onboarding-banner gymora-card mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start gap-3">
            <div class="flex-shrink-0">
                <i class="bi bi-lightning-charge-fill" style="color: var(--gymora-primary); font-size: 2.5rem;"></i>
            </div>
            <div class="flex-grow-1">
                <div style="color: var(--gymora-text); font-size: 16px; font-weight: 700;" class="mb-2">
                    Welcome to Gymora! Here's how to get started
                </div>
                <ol class="mb-3 ps-3" style="color: var(--gymora-muted); font-size: 13px;">
                    <li class="mb-1">
                        <a asp-controller="Plan" asp-action="Create" class="text-decoration-none fw-semibold" style="color: var(--gymora-primary);">Create a Membership Plan</a>
                    </li>
                    <li class="mb-1">
                        <a asp-controller="Member" asp-action="Create" class="text-decoration-none fw-semibold" style="color: var(--gymora-primary);">Add your first Member</a>
                    </li>
                    <li class="mb-0">
                        Track your gym from the Dashboard — stats and charts will appear automatically.
                    </li>
                </ol>
                <button type="button" class="gymora-btn-ghost" style="font-size: 12px; padding: 6px 14px;"
                        onclick="localStorage.setItem('gymora-onboarding-dismissed','1'); this.closest('.gymora-onboarding-banner').style.display='none';">
                    Got it, dismiss
                </button>
            </div>
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="gymora-card h-100">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div class="flex-grow-1 min-w-0">
                    <div class="gymora-stat-label">Total Members</div>
                    <div class="gymora-stat-val">@Model.TotalMembers</div>
                </div>
                <div class="gymora-stat-icon members flex-shrink-0"><i class="bi bi-people-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="gymora-card h-100">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div class="flex-grow-1 min-w-0">
                    <div class="gymora-stat-label">Active Members</div>
                    <div class="gymora-stat-val">@Model.ActiveMembers</div>
                    <span class="gymora-badge success mt-2">Active</span>
                </div>
                <div class="gymora-stat-icon income flex-shrink-0"><i class="bi bi-person-check-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="gymora-card h-100">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div class="flex-grow-1 min-w-0">
                    <div class="gymora-stat-label">Inactive Members</div>
                    <div class="gymora-stat-val">@Model.InactiveMembers</div>
                    <span class="gymora-badge danger mt-2">Inactive</span>
                </div>
                <div class="gymora-stat-icon expense flex-shrink-0"><i class="bi bi-person-x-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="gymora-card h-100">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div class="flex-grow-1 min-w-0">
                    <div class="gymora-stat-label">Joined This Month</div>
                    <div class="gymora-stat-val">@Model.MembersJoinedThisMonth</div>
                </div>
                <div class="gymora-stat-icon joined flex-shrink-0"><i class="bi bi-calendar-plus-fill"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="gymora-card h-100">
            <div class="gymora-card-header mb-3">
                <div>
                    <div class="gymora-card-title mb-1">Member Growth</div>
                    <div style="color:#9A9A9A; font-size:12px;">New members per month — last 12 months</div>
                </div>
            </div>
            @if (maxVal == 0)
            {
                <div class="text-center py-4" style="color:var(--gymora-muted);font-size:13px;">
                    <i class="bi bi-bar-chart d-block mb-2" style="font-size:2rem;"></i>
                    No member join data yet. Add members to see the chart.
                </div>
            }
            else
            {
                <canvas id="memberChart" height="200"></canvas>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="gymora-card h-100">
            <div class="gymora-card-title mb-3">Quick Actions</div>
            <div class="d-flex flex-column gap-2">
                <a asp-controller="Member" asp-action="Create" class="gymora-btn-primary w-100 text-decoration-none d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-person-plus"></i> Add New Member
                </a>
                <a asp-controller="Member" asp-action="Index" class="gymora-btn-ghost w-100 text-decoration-none d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-people"></i> View All Members
                </a>
                @if (User.IsInRole("GymOwner"))
                {
                    <a asp-controller="Plan" asp-action="Index" class="gymora-btn-ghost w-100 text-decoration-none d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-card-list"></i> Manage Plans
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        if (localStorage.getItem('gymora-onboarding-dismissed') === '1') {
            var b = document.querySelector('.gymora-onboarding-banner');
            if (b) b.style.display = 'none';
        }
    </script>
    @if (maxVal > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
          var chartLabels = @Html.Raw(chartLabels);
          var chartData   = @Html.Raw(chartData);
          var maxVal      = @maxVal;

          // Highlight the current (last) month bar
          var currentMonth = new Date().getMonth(); // 0-based, not used — just highlight the last entry
          var highlightIndex = chartData.length - 1;

          var ctx = document.getElementById('memberChart');
          new Chart(ctx, {
            type: 'bar',
            data: {
              labels: chartLabels,
              datasets: [{
                data: chartData,
                backgroundColor: function(context) {
                  return context.dataIndex === highlightIndex
                    ? '#E16349'
                    : 'rgba(225,99,73,0.25)';
                },
                borderRadius: 4,
                borderSkipped: false
              }]
            },
            options: {
              responsive: true,
              plugins: { legend: { display: false } },
              scales: {
                x: {
                  grid: { color: '#2E2E2E' },
                  ticks: { color: '#9A9A9A', font: { size: 11 } }
                },
                y: {
                  grid: { color: '#2E2E2E' },
                  ticks: {
                    color: '#9A9A9A',
                    font: { size: 11 },
                    stepSize: 1,
                    precision: 0
                  },
                  beginAtZero: true
                }
              }
            }
          });
        </script>
    }
}
