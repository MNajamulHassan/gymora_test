@model Gymora.Models.ViewModels.Dashboard.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="gymora-card h-100">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div class="flex-grow-1 min-w-0">
                    <div class="gymora-stat-label">Total Members</div>
                    <div class="gymora-stat-val">@Model.TotalMembers</div>
                </div>
                <div class="gymora-stat-icon members flex-shrink-0"><i class="bi bi-people-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="gymora-card h-100">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div class="flex-grow-1 min-w-0">
                    <div class="gymora-stat-label">Active Members</div>
                    <div class="gymora-stat-val">@Model.ActiveMembers</div>
                    <span class="gymora-badge success mt-2">Active</span>
                </div>
                <div class="gymora-stat-icon income flex-shrink-0"><i class="bi bi-person-check-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="gymora-card h-100">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div class="flex-grow-1 min-w-0">
                    <div class="gymora-stat-label">Inactive Members</div>
                    <div class="gymora-stat-val">@Model.InactiveMembers</div>
                    <span class="gymora-badge danger mt-2">Inactive</span>
                </div>
                <div class="gymora-stat-icon expense flex-shrink-0"><i class="bi bi-person-x-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="gymora-card h-100">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div class="flex-grow-1 min-w-0">
                    <div class="gymora-stat-label">Joined This Month</div>
                    <div class="gymora-stat-val">@Model.MembersJoinedThisMonth</div>
                </div>
                <div class="gymora-stat-icon joined flex-shrink-0"><i class="bi bi-calendar-plus-fill"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="gymora-card h-100">
            <div class="gymora-card-header mb-3">
                <div>
                    <div class="gymora-card-title mb-1">Member Growth</div>
                    <div style="color:#9A9A9A; font-size:12px;">Monthly overview</div>
                </div>
            </div>
            <canvas id="memberChart" height="200"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="gymora-card h-100">
            <div class="gymora-card-title mb-3">Quick Actions</div>
            <div class="d-flex flex-column gap-2">
                <a asp-controller="Member" asp-action="Create" class="gymora-btn-primary w-100 text-decoration-none d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-person-plus"></i> Add New Member
                </a>
                <a asp-controller="Member" asp-action="Index" class="gymora-btn-ghost w-100 text-decoration-none d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-people"></i> View All Members
                </a>
                @if (User.IsInRole("GymOwner"))
                {
                    <a asp-controller="Plan" asp-action="Index" class="gymora-btn-ghost w-100 text-decoration-none d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-card-list"></i> Manage Plans
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-0">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-0">@TempData["Error"]</div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
      var ctx = document.getElementById('memberChart');
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Feb','Mar','Apr','May','Jun',
                   'Jul','Aug','Sep','Oct','Nov','Dec','Jan'],
          datasets: [{
            data: [30,25,20,45,38,72,55,48,60,32,18,42],
            backgroundColor: function(context) {
              var index = context.dataIndex;
              var highlight = [5,8];
              return highlight.includes(index)
                ? '#E16349'
                : 'rgba(225,99,73,0.25)';
            },
            borderRadius: 4,
            borderSkipped: false,
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: {
            x: {
              grid: { color: '#2E2E2E' },
              ticks: { color: '#9A9A9A', font: { size: 11 } }
            },
            y: {
              grid: { color: '#2E2E2E' },
              ticks: { color: '#9A9A9A', font: { size: 11 } }
            }
          }
        }
      });
    </script>
}
