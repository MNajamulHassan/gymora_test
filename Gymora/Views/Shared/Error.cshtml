@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
    var code = Context.Response.StatusCode;
    var isNotFound = code == 404;
}

<div class="d-flex flex-column align-items-center justify-content-center text-center py-5 px-3" style="min-height: 60vh;">
    <div style="font-size: 5rem; font-weight: 800; color: var(--gymora-primary); line-height: 1;">
        @code
    </div>
    <div style="font-size: 20px; font-weight: 700; color: var(--gymora-text); margin: 16px 0 8px;">
        @(isNotFound ? "Page Not Found" : "Something went wrong")
    </div>
    <div style="font-size: 14px; color: var(--gymora-muted); max-width: 380px; margin-bottom: 28px;">
        @(isNotFound
            ? "The page you're looking for doesn't exist or has been moved."
            : "An unexpected error occurred. Please try again or contact support.")
    </div>
    <a href="/" class="gymora-btn-primary text-decoration-none d-inline-flex align-items-center gap-2">
        <i class="bi bi-house-fill"></i> Back to Home
    </a>
</div>
