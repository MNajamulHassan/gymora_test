<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gymora</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" asp-href-include="~/css/gymora.css" asp-append-version="true" href="~/css/gymora.css" />

    <style>
        .gymora-nav-link.coming-soon { opacity: 0.45; cursor: not-allowed; }
        .gymora-nav-link.coming-soon:hover { background: transparent !important; color: var(--gymora-muted) !important; }
        .gymora-sidebar:not(.collapsed) .gymora-nav-link.coming-soon { position: relative; }
        .gymora-sidebar:not(.collapsed) .gymora-nav-link.coming-soon::after {
            content: 'Soon';
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: var(--gymora-surface-2);
            color: var(--gymora-muted);
            font-size: 9px;
            font-weight: 600;
            padding: 2px 6px;
            border-radius: 4px;
            border: 1px solid var(--gymora-border);
        }
    </style>

    <script>
        (function () {
            var t = localStorage.getItem('gymora-theme') || 'dark';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var currentArea       = ViewContext.RouteData.Values["area"]?.ToString() ?? "";

        bool isHomeActive    = false;
        bool isMembersActive = false;
        bool isPlansActive   = false;
        bool isProfileActive = false;

        if (User.IsInRole("GymOwner") || User.IsInRole("Receptionist"))
        {
            isHomeActive    = currentController == "Dashboard" && string.IsNullOrEmpty(currentArea);
            isMembersActive = currentController == "Member"    && string.IsNullOrEmpty(currentArea);
            isPlansActive   = currentController == "Plan"      && string.IsNullOrEmpty(currentArea);
        }
        else if (User.IsInRole("Member"))
        {
            isHomeActive    = currentArea == "Member" && currentController == "Portal" && currentAction == "Dashboard";
            isProfileActive = currentArea == "Member" && currentController == "Portal" && currentAction == "EditProfile";
        }
    }

    <div class="gymora-wrapper">

        <!-- ══ SIDEBAR (desktop only, lg+) ══ -->
        <aside class="gymora-sidebar d-none d-lg-flex flex-column" id="gymSidebar">

            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("Member"))
                {
                    <a class="gymora-logo d-flex text-decoration-none"
                       asp-area="Member" asp-controller="Portal" asp-action="Dashboard">
                        <span style="flex-shrink:0;color:var(--gymora-primary);">&#x26A1;</span>
                        <span class="gymora-logo-text ms-2" style="color:var(--gymora-text);">Gym<span style="color:var(--gymora-primary);">ora</span></span>
                    </a>
                }
                else
                {
                    <a class="gymora-logo d-flex text-decoration-none"
                       asp-controller="Dashboard" asp-action="Index">
                        <span style="flex-shrink:0;color:var(--gymora-primary);">&#x26A1;</span>
                        <span class="gymora-logo-text ms-2" style="color:var(--gymora-text);">Gym<span style="color:var(--gymora-primary);">ora</span></span>
                    </a>
                }
            }
            else
            {
                <a class="gymora-logo d-flex text-decoration-none" asp-controller="Auth" asp-action="Login">
                    <span style="flex-shrink:0;color:var(--gymora-primary);">&#x26A1;</span>
                    <span class="gymora-logo-text ms-2" style="color:var(--gymora-text);">Gym<span style="color:var(--gymora-primary);">ora</span></span>
                </a>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("GymOwner") || User.IsInRole("Receptionist"))
                {
                    <div class="gymora-nav-section-label">Main</div>
                    <a class="gymora-nav-link @(isHomeActive ? "active" : "")"
                       asp-controller="Dashboard" asp-action="Index" data-label="Dashboard">
                        <i class="bi bi-house-fill"></i>
                        <span class="gymora-nav-link-text">Dashboard</span>
                    </a>
                    <a class="gymora-nav-link @(isMembersActive ? "active" : "")"
                       asp-controller="Member" asp-action="Index" data-label="Members">
                        <i class="bi bi-people"></i>
                        <span class="gymora-nav-link-text">Members</span>
                    </a>
                    @if (User.IsInRole("GymOwner"))
                    {
                        <a class="gymora-nav-link @(isPlansActive ? "active" : "")"
                           asp-controller="Plan" asp-action="Index" data-label="Plans">
                            <i class="bi bi-card-list"></i>
                            <span class="gymora-nav-link-text">Membership Plans</span>
                        </a>
                    }
                    <a class="gymora-nav-link coming-soon" href="#" tabindex="-1" aria-disabled="true" data-label="Attendance"
                       title="Attendance tracking — coming soon in a future update"
                       data-bs-toggle="tooltip" data-bs-placement="right">
                        <i class="bi bi-calendar-check"></i>
                        <span class="gymora-nav-link-text">Attendance</span>
                    </a>
                    <a class="gymora-nav-link coming-soon" href="#" tabindex="-1" aria-disabled="true" data-label="Payments"
                       title="Payment management — coming soon in a future update"
                       data-bs-toggle="tooltip" data-bs-placement="right">
                        <i class="bi bi-cash-stack"></i>
                        <span class="gymora-nav-link-text">Payments</span>
                    </a>
                }
                else if (User.IsInRole("Member"))
                {
                    <div class="gymora-nav-section-label">Menu</div>
                    <a class="gymora-nav-link @(isHomeActive ? "active" : "")"
                       asp-area="Member" asp-controller="Portal" asp-action="Dashboard" data-label="Dashboard">
                        <i class="bi bi-house-fill"></i>
                        <span class="gymora-nav-link-text">Dashboard</span>
                    </a>
                    <a class="gymora-nav-link @(isProfileActive ? "active" : "")"
                       asp-area="Member" asp-controller="Portal" asp-action="EditProfile" data-label="My Profile">
                        <i class="bi bi-person-circle"></i>
                        <span class="gymora-nav-link-text">My Profile</span>
                    </a>
                    <a class="gymora-nav-link coming-soon" href="#" tabindex="-1" aria-disabled="true"
                       title="View your gym visit history — coming soon"
                       data-bs-toggle="tooltip" data-bs-placement="right">
                        <i class="bi bi-calendar-check"></i>
                        <span class="gymora-nav-link-text">My Attendance</span>
                    </a>
                    <a class="gymora-nav-link coming-soon" href="#" tabindex="-1" aria-disabled="true"
                       title="View your payment history — coming soon"
                       data-bs-toggle="tooltip" data-bs-placement="right">
                        <i class="bi bi-receipt"></i>
                        <span class="gymora-nav-link-text">My Payments</span>
                    </a>
                }
            }
            else
            {
                <a class="gymora-nav-link @(currentController == "Auth" && currentAction == "Login" ? "active" : "")"
                   asp-controller="Auth" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span class="gymora-nav-link-text">Login</span>
                </a>
                <a class="gymora-nav-link @(currentController == "Auth" && currentAction == "Register" ? "active" : "")"
                   asp-controller="Auth" asp-action="Register">
                    <i class="bi bi-person-plus"></i>
                    <span class="gymora-nav-link-text">Register</span>
                </a>
            }
        </aside>

        <!-- ══ MAIN AREA ══ -->
        <div class="gymora-main" id="gymoraMain">

            <!-- Topbar -->
            <header class="gymora-topbar">

                <!-- Logo (mobile: always visible | desktop: hidden since sidebar has it) -->
                <a class="gymora-topbar-logo d-lg-none text-decoration-none" href="/">
                    <span>&#x26A1;</span> Gym<span style="color:var(--gymora-primary)">ora</span>
                </a>

                <span class="gymora-topbar-title">@ViewData["Title"]</span>

                <div class="gymora-topbar-right">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var displayName = User.Identity.Name?.Trim() ?? "";
                        var letter = displayName.Length > 0 ? char.ToUpperInvariant(displayName[0]).ToString() : "?";

                        <div class="gymora-user-dropdown" id="userDropdownWrapper">
                            <button class="gymora-user-trigger" id="userDropdownTrigger"
                                    type="button" aria-expanded="false">
                                <div class="gymora-avatar">@letter</div>
                                <span class="username d-none d-md-block">@displayName</span>
                                <i class="bi bi-chevron-down chevron"></i>
                            </button>
                            <div class="gymora-dropdown-menu" id="userDropdownMenu" role="menu">
                                <div class="gymora-dropdown-header">
                                    <div class="name">@displayName</div>
                                    <div class="email">@User.Identity.Name</div>
                                </div>

                                @if (User.IsInRole("Member"))
                                {
                                    <a class="gymora-dropdown-item"
                                       asp-area="Member" asp-controller="Portal" asp-action="EditProfile">
                                        <i class="bi bi-person-circle"></i> My Profile
                                    </a>
                                }
                                else
                                {
                                    <a class="gymora-dropdown-item" href="#">
                                        <i class="bi bi-person-circle"></i> Account Settings
                                    </a>
                                }

                                <!-- Theme toggle row inside dropdown — pill removed, just the icon+label button -->
                                <div class="gymora-dropdown-divider"></div>
                                <button type="button" class="gymora-dropdown-item" id="themeToggle">
                                    <i class="bi bi-moon-fill" id="themeIcon"></i>
                                    <span id="themeLabel">Dark Mode</span>
                                </button>

                                <div class="gymora-dropdown-divider"></div>
                                @* asp-area="" ensures logout always routes to /Auth/Logout, even when inside the Member area *@
                                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="gymora-dropdown-item danger">
                                        <i class="bi bi-box-arrow-right"></i> Log out
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Not authenticated: show standalone theme toggle -->
                        <button class="gymora-theme-toggle" id="themeToggle" type="button"
                                title="Toggle theme" aria-label="Toggle theme">
                            <i class="bi bi-moon-fill" id="themeIcon"></i>
                        </button>
                    }
                </div>
            </header>

            <!-- Page content -->
            <main class="gymora-content" id="mainContent">
                @RenderBody()
            </main>

        </div><!-- /gymora-main -->

    </div><!-- /gymora-wrapper -->

    <!-- ══ MOBILE BOTTOM NAV (hidden on lg+) ══ -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="gymora-mobile-nav d-lg-none" id="mobileNav" aria-label="Main navigation">

            @if (User.IsInRole("GymOwner") || User.IsInRole("Receptionist"))
            {
                <a class="gymora-nav-mobile-item @(isMembersActive ? "active" : "")"
                   asp-controller="Member" asp-action="Index" title="Members">
                    <i class="bi bi-people"></i>
                    <span>Members</span>
                </a>

                @if (User.IsInRole("GymOwner"))
                {
                    <a class="gymora-nav-mobile-item @(isPlansActive ? "active" : "")"
                       asp-controller="Plan" asp-action="Index" title="Plans">
                        <i class="bi bi-card-list"></i>
                        <span>Plans</span>
                    </a>
                }
                else
                {
                    <span class="gymora-nav-mobile-item disabled" title="Plans (not available)">
                        <i class="bi bi-card-list"></i>
                        <span>Plans</span>
                    </span>
                }

                <a class="gymora-mobile-home @(isHomeActive ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index" title="Dashboard (Home)">
                    <div class="gymora-mobile-home-bubble">
                        <i class="bi bi-house-fill"></i>
                    </div>
                    <span>Home</span>
                </a>

                <span class="gymora-nav-mobile-item disabled" title="Attendance (coming soon)">
                    <i class="bi bi-calendar-check"></i>
                    <span>Attend</span>
                </span>

                <span class="gymora-nav-mobile-item disabled" title="Payments (coming soon)">
                    <i class="bi bi-cash-stack"></i>
                    <span>Pay</span>
                </span>
            }
            else if (User.IsInRole("Member"))
            {
                <a class="gymora-nav-mobile-item @(isProfileActive ? "active" : "")"
                   asp-area="Member" asp-controller="Portal" asp-action="EditProfile" title="My Profile">
                    <i class="bi bi-person-circle"></i>
                    <span>Profile</span>
                </a>

                <span class="gymora-nav-mobile-item disabled" title="Attendance (coming soon)">
                    <i class="bi bi-calendar-check"></i>
                    <span>Attend</span>
                </span>

                <a class="gymora-mobile-home @(isHomeActive ? "active" : "")"
                   asp-area="Member" asp-controller="Portal" asp-action="Dashboard" title="Dashboard (Home)">
                    <div class="gymora-mobile-home-bubble">
                        <i class="bi bi-house-fill"></i>
                    </div>
                    <span>Home</span>
                </a>

                <span class="gymora-nav-mobile-item disabled" title="Payments (coming soon)">
                    <i class="bi bi-receipt"></i>
                    <span>Pay</span>
                </span>

                <span class="gymora-nav-mobile-item disabled">
                    <i class="bi bi-gear"></i>
                    <span>More</span>
                </span>
            }

        </nav>
    }

    <div class="modal fade" id="gymoraConfirmModal" tabindex="-1" aria-labelledby="gymoraConfirmLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
            <div class="modal-content" style="background:var(--gymora-surface);border:1px solid var(--gymora-border);border-radius:12px;">
                <div class="modal-body p-4">
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <i id="gymoraConfirmIcon" class="bi bi-exclamation-triangle-fill flex-shrink-0" style="font-size:1.8rem;color:var(--gymora-primary);"></i>
                        <div>
                            <div id="gymoraConfirmTitle" style="font-size:16px;font-weight:700;color:var(--gymora-text);margin-bottom:6px;"></div>
                            <div id="gymoraConfirmMessage" style="font-size:13px;color:var(--gymora-muted);"></div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <button type="button" class="gymora-btn-ghost" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" id="gymoraConfirmBtn" class="gymora-btn-danger">Confirm</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/gymora.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
