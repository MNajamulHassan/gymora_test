@model Gymora.Models.ViewModels.Plan.PlanFormViewModel
@{
    ViewData["Title"] = "Create Plan";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0"><i class="bi bi-plus-circle"></i> Create Membership Plan</h3>
    <a asp-controller="Plan" asp-action="Index" class="gymora-btn-ghost">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="gymora-card">
    <div class="p-4">
        <form asp-controller="Plan" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="PlanName" class="gymora-form-label"></label>
                <input asp-for="PlanName" class="form-control" />
                <span asp-validation-for="PlanName" class="text-danger small"></span>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="DurationDays" class="gymora-form-label"></label>
                    <input asp-for="DurationDays" class="form-control" />
                    <span asp-validation-for="DurationDays" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Price" class="gymora-form-label"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3 mt-3">
                <label asp-for="Description" class="gymora-form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="gymora-btn-primary">
                    <i class="bi bi-check-circle"></i> Save Plan
                </button>
                <a asp-controller="Plan" asp-action="Index" class="gymora-btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
