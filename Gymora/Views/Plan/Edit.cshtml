@model Gymora.Models.ViewModels.Plan.PlanFormViewModel
@{
    ViewData["Title"] = "Edit Plan";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0"><i class="bi bi-pencil-square"></i> Edit Membership Plan</h3>
    <a asp-controller="Plan" asp-action="Index" class="gymora-btn-ghost">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="gymora-card">
    <div class="p-4">
        <form asp-controller="Plan" asp-action="Edit" asp-route-id="@Model.PlanId" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="PlanId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="PlanName" class="gymora-form-label"></label>
                <input asp-for="PlanName" class="form-control" />
                <span asp-validation-for="PlanName" class="text-danger small"></span>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="DurationDays" class="gymora-form-label"></label>
                    <input asp-for="DurationPreset" type="hidden" />
                    <select id="durationPreset" class="form-select gymora-input mb-2">
                        <option value="1">1 Day</option>
                        <option value="7">1 Week</option>
                        <option value="30">1 Month</option>
                        <option value="180">6 Months</option>
                        <option value="365">1 Year</option>
                        <option value="custom">Custom</option>
                    </select>
                    <div id="customDays" style="display:none">
                        <input asp-for="DurationDays" class="form-control gymora-input" placeholder="Enter days" />
                    </div>
                    <span asp-validation-for="DurationDays" class="text-danger small"></span>
                    <div class="form-text" style="color: var(--gymora-muted); font-size: 12px;">Enter the number of days (e.g. 30 = one month, 365 = one year)</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Price" class="gymora-form-label"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                    <div class="form-text" style="color: var(--gymora-muted); font-size: 12px;">Amount in PKR (e.g. 3000)</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="AssignedTrainerId" class="gymora-form-label"></label>
                    <select asp-for="AssignedTrainerId" asp-items="Model.ActiveTrainers" class="form-select gymora-input">
                        <option value="">-- Select trainer --</option>
                    </select>
                    <span asp-validation-for="AssignedTrainerId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MaxMembers" class="gymora-form-label"></label>
                    <input asp-for="MaxMembers" class="form-control gymora-input" type="number" min="1" max="20" />
                    <span asp-validation-for="MaxMembers" class="text-danger small"></span>
                    <div class="form-text" style="color: var(--gymora-muted); font-size: 12px;">Max Members (1=individual, 2=duo, etc.)</div>
                </div>
            </div>
            <div class="mb-3 mt-3">
                <label asp-for="Description" class="gymora-form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="gymora-btn-primary" id="mainSubmitBtn" onclick="gymoraSubmitting(this)">
                    <i class="bi bi-check-circle"></i> Save Changes
                </button>
                <a asp-controller="Plan" asp-action="Index" class="gymora-btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const presetEl = document.getElementById('durationPreset');
            const daysEl = document.getElementById('DurationDays');
            const customWrap = document.getElementById('customDays');
            const initialPreset = '@Model.DurationPreset';
            presetEl.value = initialPreset || 'custom';

            const applyPreset = () => {
                const v = presetEl.value;
                document.getElementById('DurationPreset').value = v;
                if (v === 'custom') {
                    customWrap.style.display = '';
                    daysEl.type = 'number';
                } else {
                    customWrap.style.display = 'none';
                    daysEl.type = 'hidden';
                    daysEl.value = v;
                }
            };

            presetEl.addEventListener('change', applyPreset);
            applyPreset();
        })();
    </script>
}