@model Gymora.Models.ViewModels.Plan.PlanListViewModel
@{
    ViewData["Title"] = "Plans";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3" role="alert">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3" role="alert">@TempData["Error"]</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div class="gymora-card-title mb-0" style="font-size:18px;">Membership Plans</div>
    <a asp-controller="Plan" asp-action="Create" class="gymora-btn-primary text-decoration-none d-inline-flex align-items-center gap-2 flex-shrink-0">
        <i class="bi bi-plus-lg"></i> Add Plan
    </a>
</div>

@if (Model.Plans.Count == 0)
{
    <div class="gymora-card">
        <div class="text-center py-5 px-3">
            <i class="bi bi-card-checklist d-block mb-3" style="font-size:3rem;color:#9A9A9A;"></i>
            <div class="gymora-card-title mb-2">No plans yet</div>
            <div style="color:#9A9A9A;font-size:14px;">Create your first membership plan to get started.</div>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var plan in Model.Plans)
        {
            <div class="col-md-6 col-xl-4">
                <div class="gymora-card h-100 d-flex flex-column">

                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div style="font-size:16px;font-weight:600;color:var(--gymora-text);">@plan.PlanName</div>
                        <span class="gymora-badge @(plan.IsActive ? "success" : "muted") flex-shrink-0">
                            @(plan.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                    <div class="mb-2 d-flex align-items-baseline flex-wrap gap-1">
                        <span style="font-size:24px;font-weight:700;color:var(--gymora-text);">@plan.Price.ToString("N2")</span>
                        <span style="font-size:12px;color:var(--gymora-muted);position:relative;top:1px;">PKR</span>
                    </div>

                    <div style="color:#9A9A9A;font-size:14px;" class="mb-2">@plan.DurationDays days</div>

                    @if (!string.IsNullOrWhiteSpace(plan.Description))
                    {
                        <div style="color:#9A9A9A;font-size:13px;" class="mb-3">@plan.Description</div>
                    }

                    <hr class="mt-auto mb-3" style="border-color:var(--gymora-border);opacity:1;" />

                    <div class="d-flex flex-wrap gap-2">

                        <a asp-controller="Plan" asp-action="Edit" asp-route-id="@plan.PlanId"
                           class="gymora-btn-ghost text-decoration-none d-inline-flex align-items-center justify-content-center gap-1 flex-grow-1"
                           style="min-width:0;">
                            <i class="bi bi-pencil"></i> Edit
                        </a>

                        <form asp-controller="Plan" asp-action="ToggleActive" asp-route-id="@plan.PlanId"
                              method="post" class="flex-grow-1 d-flex" style="min-width:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="gymora-btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1"
                                    onclick="return confirm('Change active status for this plan?');">
                                <i class="bi bi-@(plan.IsActive ? "pause-circle" : "play-circle")"></i>
                                @(plan.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>

                        <form asp-controller="Plan" asp-action="Delete" asp-route-id="@plan.PlanId"
                              method="post" class="d-flex" style="min-width:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="gymora-btn-danger d-inline-flex align-items-center justify-content-center gap-1"
                                    style="padding:10px 14px;"
                                    title="Delete plan"
                                    onclick="return confirm('Permanently delete this plan? This cannot be undone.');">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
}
