@model MemberDetailViewModel
@{
    ViewData["Title"] = "My Dashboard";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Greeting Banner -->
<div class="p-4 mb-4 rounded-3"
     style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
    <div class="d-flex align-items-center gap-4">
        <div class="rounded-circle bg-secondary d-inline-flex align-items-center
                    justify-content-center fw-bold fs-2 flex-shrink-0"
             style="width:75px; height:75px; color:#ffffff;">
            @Model.Initials
        </div>
        <div>
            <h3 class="mb-1 fw-bold" style="color:#ffffff;">Welcome back, @Model.FullName!</h3>
            <p class="mb-0" style="color:rgba(255,255,255,0.75);">
                <i class="bi bi-calendar3"></i>
                Member since @(Model.JoinDate.HasValue ? Model.JoinDate.Value.ToString("MMMM yyyy") : "N/A")
            </p>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Membership Status -->
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-patch-check-fill text-success" style="font-size: 2.5rem;"></i>
                <h5 class="mt-3 fw-bold">Membership Status</h5>
                <span class="badge bg-success rounded-pill fs-6 px-4 py-2 mt-2">
                    ✓ Active
                </span>
                <p class="text-muted small mt-3 mb-0">Your membership is active.</p>
            </div>
        </div>
    </div>

    <!-- Profile Summary -->
    <div class="col-md-8">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">
                <i class="bi bi-person-lines-fill"></i> Profile Summary
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-3">
                    <li class="mb-2">
                        <i class="bi bi-person text-primary me-2"></i>
                        <strong>Name:</strong> @Model.FullName
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-envelope text-primary me-2"></i>
                        <strong>Email:</strong> @Model.Email
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-telephone text-primary me-2"></i>
                        <strong>Phone:</strong> @(Model.PhoneNumber ?? "—")
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-calendar-check text-primary me-2"></i>
                        <strong>Join Date:</strong>
                        @(Model.JoinDate.HasValue ? Model.JoinDate.Value.ToString("dd MMM yyyy") : "—")
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-card-checklist text-primary me-2"></i>
                        <strong>Current Plan:</strong> @(Model.CurrentPlanName ?? "—")
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-hourglass-split text-primary me-2"></i>
                        <strong>Plan Expiry:</strong>
                        @(Model.PlanExpiryDate.HasValue ? Model.PlanExpiryDate.Value.ToString("dd MMM yyyy") : "—")
                    </li>
                    @if (!string.IsNullOrWhiteSpace(Model.FitnessGoals))
                    {
                        <li class="mb-2">
                            <i class="bi bi-trophy text-primary me-2"></i>
                            <strong>Fitness Goals:</strong> @Model.FitnessGoals
                        </li>
                    }
                </ul>
                <a asp-area="Member" asp-controller="Portal" asp-action="EditProfile"
                   class="btn btn-primary btn-sm">
                    <i class="bi bi-pencil"></i> Edit My Profile
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Links -->
<div class="row g-3 mt-2">
    <div class="col-12">
        <h5 class="fw-bold text-muted mb-3">Quick Links</h5>
    </div>
    <div class="col-md-3">
        <div class="card text-center py-4 border-0 opacity-75"
             style="background: var(--gymora-surface-2);">
            <div class="card-body">
                <i class="bi bi-calendar-check text-secondary" style="font-size: 2rem;"></i>
                <p class="mt-2 fw-semibold mb-0">My Attendance</p>
                <small class="text-muted">Coming soon</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center py-4 border-0 opacity-75"
             style="background: var(--gymora-surface-2);">
            <div class="card-body">
                <i class="bi bi-receipt text-secondary" style="font-size: 2rem;"></i>
                <p class="mt-2 fw-semibold mb-0">My Payments</p>
                <small class="text-muted">Coming soon</small>
            </div>
        </div>
    </div>
</div>
