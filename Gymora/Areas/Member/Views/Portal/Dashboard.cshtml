@model MemberDetailViewModel
@{
    ViewData["Title"] = "My Dashboard";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Greeting Banner -->
<div class="gymora-card mb-4">
    <div class="p-4 d-flex align-items-center gap-4">
        <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold flex-shrink-0"
             style="width:75px; height:75px; font-size:28px; background:var(--gymora-primary); color:#FFFFFF;">
            @Model.Initials
        </div>
        <div>
            <h3 class="mb-1 fw-bold" style="color:var(--gymora-text);">Welcome back, @Model.FullName!</h3>
            <span class="gymora-badge" style="background:var(--gymora-primary-dim);color:var(--gymora-primary);">@Model.MemberCode</span>
            <p class="mb-0" style="color:var(--gymora-muted);">
                <i class="bi bi-calendar3"></i>
                Member since @(Model.JoinDate.HasValue ? Model.JoinDate.Value.ToString("MMMM yyyy") : "N/A")
            </p>
        </div>
    </div>
</div>

@{
    var today = DateTime.Today;
    bool planExpired = Model.PlanExpiryDate.HasValue && Model.PlanExpiryDate.Value.Date < today;
    int? daysUntilExpiry = Model.PlanExpiryDate.HasValue
        ? (int?)(Model.PlanExpiryDate.Value.Date - today).TotalDays
        : null;
}

<div class="row g-4">
    <!-- Membership Status -->
    <div class="col-md-4">
        <div class="gymora-card h-100 text-center py-4">
            @if (!Model.IsActive)
            {
                <i class="bi bi-x-circle-fill d-block mb-2" style="font-size: 2.5rem; color: var(--gymora-danger);"></i>
                <div class="gymora-card-title mt-3 mb-2">Membership Status</div>
                <span class="gymora-badge danger mt-2 d-inline-block">✗ Inactive</span>
                <p class="small mt-3 mb-0" style="color: var(--gymora-danger); font-size: 13px;">Your account has been deactivated. Please contact the gym.</p>
            }
            else if (planExpired)
            {
                <i class="bi bi-x-circle-fill d-block mb-2" style="font-size: 2.5rem; color: var(--gymora-danger);"></i>
                <div class="gymora-card-title mt-3 mb-2">Membership Status</div>
                <span class="gymora-badge danger mt-2 d-inline-block">✗ Expired</span>
                <p class="small mt-3 mb-0" style="color: var(--gymora-danger); font-size: 13px;">Your plan expired on @(Model.PlanExpiryDate!.Value.ToString("MMM dd, yyyy")). Please contact the gym to renew.</p>
            }
            else if (daysUntilExpiry.HasValue && daysUntilExpiry.Value >= 0 && daysUntilExpiry.Value <= 7)
            {
                <i class="bi bi-exclamation-triangle-fill d-block mb-2" style="font-size: 2.5rem; color: var(--gymora-primary);"></i>
                <div class="gymora-card-title mt-3 mb-2">Membership Status</div>
                <span class="gymora-badge warning mt-2 d-inline-block">Expiring Soon</span>
                <p class="small mt-3 mb-0" style="color: var(--gymora-primary); font-size: 13px;">Your plan expires in @daysUntilExpiry day(s). Contact the gym to renew.</p>
            }
            else
            {
                <i class="bi bi-patch-check-fill d-block mb-2" style="font-size: 2.5rem; color: var(--gymora-secondary);"></i>
                <div class="gymora-card-title mt-3 mb-2">Membership Status</div>
                <span class="gymora-badge success mt-2 d-inline-block">✓ Active</span>
                <p class="small mt-3 mb-0" style="color: var(--gymora-muted); font-size: 13px;">Your membership is active.</p>
            }
        </div>
    </div>

    <!-- Profile Summary -->
    <div class="col-md-8">
        <div class="gymora-card h-100">
            <div class="gymora-card-title mb-3">
                <i class="bi bi-person-lines-fill"></i> Profile Summary
            </div>
            <div>
                <ul class="list-unstyled mb-3">
                    <li class="mb-2">
                        <i class="bi bi-person me-2" style="color:var(--gymora-primary);"></i>
                        <strong>Name:</strong> @Model.FullName
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-envelope me-2" style="color:var(--gymora-primary);"></i>
                        <strong>Email:</strong> @Model.Email
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-telephone me-2" style="color:var(--gymora-primary);"></i>
                        <strong>Phone:</strong> @(Model.PhoneNumber ?? "—")
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-calendar-check me-2" style="color:var(--gymora-primary);"></i>
                        <strong>Join Date:</strong>
                        @(Model.JoinDate.HasValue ? Model.JoinDate.Value.ToString("dd MMM yyyy") : "—")
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-card-checklist me-2" style="color:var(--gymora-primary);"></i>
                        <strong>Current Plan:</strong> @(Model.CurrentPlanName ?? "—")
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-calendar-plus me-2" style="color:var(--gymora-primary);"></i>
                        <strong>Plan Started:</strong>
                        @(Model.PlanStartDate.HasValue ? Model.PlanStartDate.Value.ToString("dd MMM yyyy") : "—")
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-hourglass-split me-2" style="color:var(--gymora-primary);"></i>
                        <strong>Plan Expiry:</strong>
                        @(Model.PlanExpiryDate.HasValue ? Model.PlanExpiryDate.Value.ToString("dd MMM yyyy") : "—")
                    </li>
                    @if (!string.IsNullOrWhiteSpace(Model.FitnessGoals))
                    {
                        <li class="mb-2">
                            <i class="bi bi-trophy me-2" style="color:var(--gymora-primary);"></i>
                            <strong>Fitness Goals:</strong> @Model.FitnessGoals
                        </li>
                    }
                </ul>
                <a asp-area="Member" asp-controller="Portal" asp-action="EditProfile"
                   class="gymora-btn-primary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-pencil"></i> Edit My Profile
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Links -->
<div class="row g-3 mt-2">
    <div class="col-12">
        <h5 class="fw-bold text-muted mb-3">Quick Links</h5>
    </div>
    <div class="col-md-3">
        <div class="gymora-card text-center py-4 opacity-75 h-100">
            <i class="bi bi-calendar-check d-block mb-2" style="font-size: 2rem; color:var(--gymora-muted)"></i>
            <p class="mt-2 fw-semibold mb-0" style="color:var(--gymora-text);">My Attendance</p>
            <small class="text-muted">Coming soon</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="gymora-card text-center py-4 opacity-75 h-100">
            <i class="bi bi-receipt d-block mb-2" style="font-size: 2rem; color:var(--gymora-muted)"></i>
            <p class="mt-2 fw-semibold mb-0" style="color:var(--gymora-text);">My Payments</p>
            <small class="text-muted">Coming soon</small>
        </div>
    </div>
</div>